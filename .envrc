#!/usr/bin/env bash

source_up_if_exists

# The dev shell contains `greet` built by gonixgo, so reload it (and rebuild
# greet) whenever the Go sources change. watch_dir covers files added later
# too; Nix only sees files that git tracks, so `git add` new ones.
watch_file go.mod go.sum
watch_dir cmd
watch_dir internal

# Evaluating a gonixgo package runs `gonixgo resolve` through builtins.exec.
use flake . --option allow-unsafe-native-code-during-evaluation true
